{
	"name": "electrobun-webgpu-babylon",
	"version": "1.0.0",
	"type": "module",
	"description": "A Babylon.js WebGPU platformer starter",
	"scripts": {
		"start": "hutch electrobun dev",
		"dev": "hutch electrobun dev --watch",
		"build": "hutch electrobun build --env=production",
		"build:canary": "hutch electrobun build --env=canary"
	},
	"dependencies": {
		"electrobun": "file:../../package",
		"@babylonjs/core": "^7.45.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5.7.2"
	}
}
